# Local admin: Gemini Decisions API (gemini-decision-1)
# Copy to .env and set your Gemini API key. Do not commit .env.
GEMINI_API_KEY=

# Parent operator login + Gmail. OAuth callback:
# http://localhost:8091/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PARENT_ADMIN_EMAILS=
PARENT_AUTH_SECRET=
PARENT_ORIGIN=http://localhost:8091
# Optional fixed sender for shop notifications; must be allowed and connected.
PARENT_MAIL_SENDER=
# A shared, random server secret of at least 32 characters.
PARENT_INTEGRATION_SECRET=
SHOP_ADMIN_ORIGIN=http://127.0.0.1:3000
