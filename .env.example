# Local admin: Gemini Decisions API (gemini-decision-1)
# Copy to .env and set your Gemini API key. Do not commit .env.
GEMINI_API_KEY=
# Public chat defaults to the service Gemini key. Set byok to require visitors' own keys.
PUBLIC_AI_MODE=managed
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=low
PUBLIC_AI_DAILY_LIMIT=1000
PUBLIC_AI_IP_DAILY_LIMIT=100

# Parent operator login + Gmail. OAuth callback:
# http://localhost:8091/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PARENT_ADMIN_EMAILS=
PARENT_AUTH_SECRET=
# Optional: 32+ characters. Enables /auth/demo?token=... which signs in as the connected operator (demo use only).
PARENT_DEMO_LOGIN_TOKEN=
PARENT_ORIGIN=http://localhost:8091
# Optional fixed sender for shop notifications; must be allowed and connected.
PARENT_MAIL_SENDER=
# A shared, random server secret of at least 32 characters.
PARENT_INTEGRATION_SECRET=
SHOP_ADMIN_ORIGIN=http://127.0.0.1:3000
