# Use true only for local demos; always false in production.
DEMO_MODE=true
PORT=3000
APP_ORIGIN=http://localhost:3000
# Production: copy .env.production.example to .env.production for https://gemihub.net.
# Business and operational data use Firestore. Local DEMO_MODE=true uses memory and resets on restart.
FIRESTORE_DATABASE_ID=gemihub
# For local Firestore Emulator testing only; a cloud database is not required.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Use a persistent random secret of at least 32 characters in production. Changing it invalidates encrypted OAuth tokens.
SESSION_SECRET=
# Uses server Application Default Credentials; shop owners do not enter API keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set a Gemini model ID available in your project and region.
VERTEX_MODEL=
# Optional independent first-theme reviewer; empty uses VERTEX_MODEL in a fresh context.
VERTEX_REVIEW_MODEL=
# Optional model for theme and page HTML/CSS generation; empty uses VERTEX_MODEL.
VERTEX_DESIGN_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public domain with wildcard DNS/HTTPS configured (e.g. shops.example.com).
SITE_DOMAIN=
# Configured models (defaults: gemini-4-hydrogen / gemini-nano-banana-2.1).
GEMINI_MODEL=gemini-4-hydrogen
# Independent theme and page HTML/CSS model. Takes precedence over VERTEX_DESIGN_MODEL.
GEMINI_DESIGN_MODEL=gemini-4-neon
GEMINI_THINKING_LEVEL=low
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Image region: falls back to GOOGLE_CLOUD_LOCATION, then global.
VERTEX_IMAGE_LOCATION=global

# PayPal: Sandboxで検証。秘密情報はサーバーのみで使用します。
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
# Secret Managerから環境変数で渡すか、ローカルのファイルパスを指定（両方ある場合は環境変数を優先）。
PAYPAL_CLIENT_SECRET=
PAYPAL_CLIENT_SECRET_FILE=tmp/paypal.secret
# PayPal Alerts: 定期チェックの間隔（分）と、各ルールのしきい値。
# PAYPAL_ALERT_INTERVAL_MINUTES=60
# PAYPAL_REFUND_STALL_HOURS=2
# PAYPAL_CAPTURE_STALL_MINUTES=15

# Google integration failure alerts (developer webhook). Leave unset to disable.
# OPS_WEBHOOK_URL=
# OPS_WEBHOOK_SECRET=
# OPS_WEBHOOK_FORMAT=generic
# OPS_MAIL_FAILURE_MINUTES=5
# OPS_DRIVE_FAILURE_MINUTES=15
# OPS_FAILURE_COUNT=3
# OPS_MAIL_STALL_MINUTES=5
# OPS_DRIVE_STALL_MINUTES=15
# OPS_SUMMARY_HOURS=6
# OPS_OWNER_MAIL_DELAY_MINUTES=30
# OPS_OWNER_NEAR_VISIT_HOURS=2
# OPS_FINAL_ALERT_DAYS=7
# OPS_INCIDENT_RETENTION_DAYS=30

# Sandbox E2E検証用（サーバーの決済認証には使用しません）
# PAYPAL_BUYER_FILE=tmp/paypal.personal.json

# Hackathon judge access (unset JUDGE_INVITE to disable). Never commit real values.
# JUDGE_INVITE=
# JUDGE_UNTIL=2027-01-31T15:00:00Z
# JUDGE_AI_LIMIT=200
# Invitation password required before a new Google owner creates a shop.
# ACCESS_PASSWORD=
# Google accounts allowed to open /admin (comma-separated).
# ADMIN_EMAILS=
# Optional OpenAI provider, selectable from /admin.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_REVIEW_MODEL=
# OPENAI_IMAGE_MODEL=
# Optional Gemini Live model for the assistant's voice ("Consult & ask"). Empty hides voice.
# VERTEX_LIVE_MODEL=
# VERTEX_LIVE_LOCATION=us-central1
# AI phone reception (Twilio Programmable Voice + Gemini Live). Leave the Twilio values empty to disable.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Optional numbers for the English (US) and Japanese judge phone demo. Use E.164.
# JUDGE_PHONE_NUMBER=
# JUDGE_PHONE_NUMBER_JA=
# Public origin Twilio reaches for the media stream; defaults to APP_ORIGIN.
# PHONE_STREAM_ORIGIN=
# Optional separate Gemini Live model/location for phone calls; falls back to VERTEX_LIVE_*.
# PHONE_LIVE_MODEL=
# PHONE_LIVE_LOCATION=us-central1
# Local demos only: accept unsigned webhooks (never in production).
# TWILIO_SKIP_SIGNATURE=true

# 飲食店の予約エージェント（docs/restaurant-agent.md）。DEMO_MODE=true のときだけ、デモ用の3店を用意します。
# SEED=restaurant-demo
# SEED_BANQUET_DATE=2026-12-18
# お客様のブラウザが既定で使う LLM ルーターとモデル（キーはお客様自身のもの）。
# AGENT_LLM_ROUTER=https://api.otari.ai/api/v1
# AGENT_LLM_MODEL=alibaba/qwen3.8-flash
# ロードバランサーの後ろで動かす場合、信頼するプロキシの段数（Cloud Run は 1）。MCP の回数制限を訪問者ごとに数えます。
# TRUSTED_PROXY_HOPS=1
# このサーバーの飲食店を登録しているお店さがしサイト。予約ページの埋め込みとLLM中継を許可する相手になります。
# AGENT_PARENT_URL=http://localhost:8090/

# Private file storage uses service credentials (ADC), independent of owner sign-in.
# Falls back to STOREFRONT_BUCKET when SHOP_FILES_BUCKET is empty.
SHOP_FILES_BUCKET=
STOREFRONT_BUCKET=
# Parent Gmail relay (optional; omit when running the shop independently).
PARENT_MAIL_URL=
PARENT_SHOPS_URL=
PARENT_INTEGRATION_SECRET=
# Standalone Gmail service sender: the operator's OAuth refresh token, not a shop owner's.
# Uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above. Never commit real credentials.
PLATFORM_GMAIL_REFRESH_TOKEN=
# Public assistants and Google generation use this server-side key when configured.
GEMINI_API_KEY=
PUBLIC_AI_MODE=managed
# managed = site Gemini + optional visitor BYOK; byok = visitor keys only.
# Public parent-guide intent and shop selection with Gemini Decisions.
PUBLIC_AI_FINDER_ROUTING=true
PUBLIC_AI_MAX_CONCURRENT=4
PUBLIC_AI_DAILY_LIMIT=1000
PUBLIC_AI_IP_DAILY_LIMIT=100
# Optional: GOOGLE_AI_AUTH=vertex keeps ADC/Vertex for the owner's Google generation.
