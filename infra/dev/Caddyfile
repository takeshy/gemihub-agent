(dev-noindex) {
    header X-Robots-Tag "noindex, nofollow"
}
dev.gemihub.net {
    import dev-noindex
    handle /api/ai/* {
        reverse_proxy app:3000 {
            header_up Host shop.dev.gemihub.net
        }
    }
    handle {
        reverse_proxy app:8090
    }
}
admin.dev.gemihub.net {
    import dev-noindex
    @internal path /api/internal/mail
    respond @internal 404
    reverse_proxy app:8091
}
shop.dev.gemihub.net {
    import dev-noindex
    @challenge_demo path /s/akari /s/akari/* /s/trattoria-sole /s/trattoria-sole/* /s/kanton-ryu /s/kanton-ryu/* /s/komado /s/komado/* /api/public/akari /api/public/akari/* /api/public/trattoria-sole /api/public/trattoria-sole/* /api/public/kanton-ryu /api/public/kanton-ryu/*
    handle @challenge_demo {
        reverse_proxy challenge-demo:3010
    }
    handle {
        reverse_proxy app:3000
    }
}
