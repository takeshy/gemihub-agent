{
  "name": "gemihub-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/shop"
  ],
  "dependencies": {
    "googleapis": "171.3.0",
    "parse5": "^8.0.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "playwright": "^1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "scripts": {
    "build": "npm run build:finder && npm run build:admin && npm run build:shop",
    "build:finder": "node scripts/build.mjs",
    "build:shop": "npm run build --workspace @gemihub/shop",
    "admin": "npm run build:admin && node --env-file-if-exists=.env admin/server.mjs",
    "check": "npm run check:finder && npm run check:admin && npm run check:shop",
    "check:finder": "node scripts/build.mjs --check",
    "check:shop": "npm run check --workspace @gemihub/shop",
    "start": "node --env-file-if-exists=.env --import tsx scripts/serve.mjs",
    "start:shop": "npm run start --workspace @gemihub/shop",
    "dev:shop": "npm run dev --workspace @gemihub/shop",
    "storybook": "npm run storybook --workspace @gemihub/shop",
    "dev:demo": "node --env-file-if-exists=.env scripts/dev-demo.mjs",
    "test": "npm run test:finder && npm run test:shop",
    "test:finder": "node --test \"tests/*.test.mjs\"",
    "test:shop": "npm run test --workspace @gemihub/shop",
    "test:browser": "node tests/browser-check.mjs",
    "test:admin": "node tests/admin-browser-check.mjs",
    "test:storage-auth": "node --import tsx tests/storage-auth-browser-check.mjs",
    "test:managed-ai": "node --import tsx tests/managed-ai-browser-check.mjs",
    "test:shop-frame": "node tests/shop-frame-check.mjs",
    "check:partners": "node scripts/check-partners.mjs",
    "build:admin": "vite build --config admin/editor/vite.config.mjs",
    "check:admin": "tsc -p admin/editor/tsconfig.json"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "typescript": "^5.9.2"
  }
}
