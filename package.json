{
  "name": "gemihub-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "workspaces": ["apps/shop"],
  "dependencies": { "googleapis": "171.3.0" },
  "scripts": {
    "build": "npm run build:finder && npm run build:shop",
    "build:finder": "node scripts/build.mjs",
    "build:shop": "npm run build --workspace @gemihub/shop",
    "admin": "node --env-file-if-exists=.env admin/server.mjs",
    "check": "npm run check:finder && npm run check:shop",
    "check:finder": "node scripts/build.mjs --check",
    "check:shop": "npm run check --workspace @gemihub/shop",
    "start": "node vendor/agentify-website/scripts/serve_site.mjs site --port 8090 --open-as localhost",
    "start:shop": "npm run start --workspace @gemihub/shop",
    "dev:shop": "npm run dev --workspace @gemihub/shop",
    "dev:demo": "node --env-file-if-exists=.env scripts/dev-demo.mjs",
    "test": "npm run test:finder && npm run test:shop",
    "test:finder": "node --test \"tests/*.test.mjs\"",
    "test:shop": "npm run test --workspace @gemihub/shop",
    "test:browser": "node tests/browser-check.mjs",
    "test:admin": "node tests/admin-browser-check.mjs",
    "test:storage-auth": "node --import tsx tests/storage-auth-browser-check.mjs",
    "test:shop-frame": "node tests/shop-frame-check.mjs",
    "check:partners": "node scripts/check-partners.mjs"
  }
}
